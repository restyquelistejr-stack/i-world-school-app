# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env*.local
.env.production
.env.development

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Editor
.vscode/*
!.vscode/extensions.json
.idea
*.swp
*.swo
*~

# Scratch / personal / OS
*.pages
*.template
phantom.txt
reset.txt
reset-security
for_delete/

# Supabase local (if you use supabase CLI)
/supabase/.branches
/supabase/.temp